# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
Godot/
artifacts/

# IDE / agent tool directories
.codex/
.workbuddy-ai/
.workbuddy/
tmp/

# Third-party source assets (large originals; exported GLBs live in art/models/)
# Keep originals ignored by default, except the pinned complete Kenney archive.
art/source/*
!art/source/kenney/
art/source/kenney/*
!art/source/kenney/nature_kit/
art/source/kenney/nature_kit/*
!art/source/kenney/nature_kit/kenney_nature-kit.zip

# Godot regenerates the GLB import descriptors for the complete art library.
art/models/kenney/nature_kit/*.glb.import
